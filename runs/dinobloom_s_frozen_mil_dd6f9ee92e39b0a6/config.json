{
  "data": {
    "run_dir": "data/full_run_v2",
    "input_dir": "data/dataset/Original",
    "source": "clean_rgb",
    "isolate": true,
    "cache_size": 128,
    "margin": 0.25,
    "task": "4way",
    "max_cells": 24,
    "max_cells_eval": 64,
    "feature_groups": [
      "cell_shape",
      "cell_texture",
      "apc",
      "log"
    ],
    "exclude_border_cells": false
  },
  "model": {
    "encoder": "dinobloom_s",
    "pretrained": true,
    "weights_path": "data/weights/DinoBloom-S.pth",
    "input_size": 112,
    "freeze": "frozen",
    "last_k": 2,
    "lora_rank": 8,
    "lora_alpha": 16.0,
    "lora_dropout": 0.0,
    "lora_targets": [
      "attn.qkv",
      "attn.proj"
    ],
    "head": "mil",
    "hidden": 256,
    "dropout": 0.2,
    "use_features": false,
    "feature_hidden": 32,
    "feature_group_dropout": 0.1
  },
  "aug": {
    "flips": true,
    "rot90": true,
    "scale_jitter": 0.1,
    "colour": "hed",
    "colour_strength": 0.05,
    "grayscale_p": 0.2,
    "blur_p": 0.1
  },
  "train": {
    "epochs": 30,
    "batch_size": 16,
    "lr_head": 0.001,
    "lr_encoder": 1e-05,
    "lr_lora": 0.0001,
    "weight_decay": 0.05,
    "warmup_frac": 0.1,
    "label_smoothing": 0.1,
    "class_weighting": "inv_sqrt",
    "grad_clip": 1.0,
    "patience": 8,
    "seed": 0,
    "num_workers": 0,
    "device": "cpu",
    "amp": true,
    "max_train_images": null,
    "max_eval_images": null
  },
  "name": "dinobloom_s_frozen_mil"
}